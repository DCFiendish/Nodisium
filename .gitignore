desktop.ini
.claude/
*.iml
.idea/
*.log

# Root/aggregator Gradle build output (each module has its own nested .gitignore for its own build/)
/build/
/.gradle/
/.kotlin/
/modules/build/

# Map-generation scratch output (heightmaps, .tif, region exports) -- regenerable from source
# inputs, not deliverables, and too large to be worth tracking (~430MB).
/tools/agadir-mapgen/agadir-*.tif
/tools/agadir-mapgen/agadir-*.png
/tools/agadir-mapgen/test-crop-*
/tools/agadir-mapgen/*-world-export*/
/tools/agadir-mapgen/test-map-export/

# Raw third-party downloads and local backup copies -- not source, not tracked.
/Downloaded glb assets/
*.bak

# Runtime server data (world saves, player state, DB) -- regenerates at runtime,
# not source.
/server/nodisium-data/
/server/combat/hats/

# Local scratch: process pid file from run scripts.
/pid.txt

# Map-generation local scratch: timestamped heightmap backups, raw climate data download,
# and a downloaded third-party tree pack -- not source, not tracked (same policy as the
# other agadir-mapgen raw-input/scratch entries above).
/tools/agadir-mapgen/backups/
/tools/agadir-mapgen/worldclim/
/tools/agadir-mapgen/sijmenvb-trees/
/tools/agadir-mapgen/__pycache__/
